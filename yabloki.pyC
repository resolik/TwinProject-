import telebot
import random
import sqlite3
from datetime import datetime, timedelta

# --- НАСТРОЙКИ ---
TOKEN = "8666686568:AAG8XBPaDdnj0rg18Zt9XDbh_ab-5PozekA"
bot = telebot.TeleBot(TOKEN)

# --- БАЗА ДАННЫХ ---
def init_db():
    conn = sqlite3.connect("apples.db", check_same_thread=False)
    cur = conn.cursor()
    cur.execute("""CREATE TABLE IF NOT EXISTS users (
        user_id INTEGER PRIMARY KEY,
        apples INTEGER DEFAULT 100,
        last_harvest TEXT,
        bank_amount INTEGER DEFAULT 0,
        bank_time TEXT
    )""")
    conn.commit()
    conn.close()

def get_user(user_id):
    conn = sqlite3.connect("apples.db", check_same_thread=False)
    cur = conn.cursor()
    cur.execute("SELECT apples, last_harvest, bank_amount, bank_time FROM users WHERE user_id = ?", (user_id,))
    user = cur.fetchone()
    if not user:
        cur.execute("INSERT INTO users (user_id, apples) VALUES (?, ?)", (user_id, 100))
        conn.commit()
        user = (100, None, 0, None)
    conn.close()
    return user

def update_apples(user_id, amount):
    conn = sqlite3.connect("apples.db", check_same_thread=False)
    cur = conn.cursor()
    cur.execute("UPDATE users SET apples = apples + ? WHERE user_id = ?", (amount, user_id))
    conn.commit()
    conn.close()

# --- КОМАНДЫ ---

@bot.message_handler(commands=['start'])
def start(message):
    get_user(message.from_user.id)
    text = (f"🍎 Привет, {message.from_user.first_name}!\n\n"
            "🌳 /harvest — собрать яблоки (раз в час)\n"
            "💰 /balance — твой счет\n"
            "🎰 /dep [сумма] — играть (казино)\n"
            "🏦 /bank [сумма] — вклад (до 300🍎, x1.2 за 2ч)\n"
            "📥 /claim — забрать вклад\n"
            "🤝 /give [сумма] — подарить (ответом на смс)")
    bot.reply_to(message, text)

@bot.message_handler(commands=['balance'])
def balance(message):
    user = get_user(message.from_user.id)
    msg = f"💰 В корзине: {user[0]} яблок 🍎"
    if user[2] and user[2] > 0:
        msg += f"\n🏦 В банке: {user[2]} яблок"
    bot.reply_to(message, msg)

@bot.message_handler(commands=['dep'])
def dep_cmd(message):
    uid = message.from_user.id
    args = message.text.split()
    if len(args) < 2 or not args[1].isdigit():
        bot.reply_to(message, "Используй: /dep [сумма]")
        return
    amount = int(args[1])
    user = get_user(uid)
    if amount < 10 or amount > user[0]:
        bot.reply_to(message, "❌ Мало яблок или ставка меньше 10!")
        return
    res = random.choices([0, 1, 2, 10], weights=[45, 30, 20, 5], k=1)[0]
    win = amount * res
    update_apples(uid, -amount + win)
    msgs = {0: "🍎 ➔ 💨 Сгнили! (x0)", 1: "🍏 При своих! (x1)", 2: "📈 Удвоил! (x2)", 10: "🔥 ДЖЕКПОТ! (x10)"}
    bot.reply_to(message, f"{msgs[res]}\nИтог: {win} яблок.")

@bot.message_handler(commands=['bank'])
def bank_deposit(message):
    uid = message.from_user.id
    args = message.text.split()
    if len(args) < 2 or not args[1].isdigit():
        bot.reply_to(message, "Используй: /bank [сумма]")
        return
    amount = int(args[1])
    user = get_user(uid)
    if user[2] and user[2] > 0:
        bot.reply_to(message, "❌ У тебя уже есть вклад! Сначала /claim.")
        return
    if amount < 10 or amount > 300:
        bot.reply_to(message, "❌ Можно положить от 10 до 300 яблок!")
        return
    if amount > user[0]:
        bot.reply_to(message, "❌ Нет столько яблок!")
        return
    now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    conn = sqlite3.connect("apples.db", check_same_thread=False)
    cur = conn.cursor()
    cur.execute("UPDATE users SET apples = apples - ?, bank_amount = ?, bank_time = ? WHERE user_id = ?", 
                (amount, amount, now, uid))
    conn.commit()
    conn.close()
    bot.reply_to(message, f"🏦 Положил {amount} 🍎 в банк. Жди 2 часа и пиши /claim!")

@bot.message_handler(commands=['claim'])
def bank_claim(message):
    uid = message.from_user.id
    user = get_user(uid)
    if not user[2] or user[2] == 0:
        bot.reply_to(message, "❌ Вкладов нет.")
        return
    bank_time = datetime.strptime(user[3], '%Y-%m-%d %H:%M:%S')
    if datetime.now() < bank_time + timedelta(hours=2):
        rem = (bank_time + timedelta(hours=2)) - datetime.now()
        bot.reply_to(message, f"⏳ Рано! Осталось {int(rem.total_seconds() // 60)} мин.")
        return
    reward = int(user[2] * 1.2)
    conn = sqlite3.connect("apples.db", check_same_thread=False)
    cur = conn.cursor()
    cur.execute("UPDATE users SET apples = apples + ?, bank_amount = 0, bank_time = NULL WHERE user_id = ?", 
                (reward, uid))
    conn.commit()
    conn.close()
    bot.reply_to(message, f"📥 Забрал {reward} яблок из банка! 🍎")

@bot.message_handler(commands=['harvest'])
def harvest(message):
    uid = message.from_user.id
    user = get_user(uid)
    last_h = user[1]
    now = datetime.now()
    if last_h:
        last_dt = datetime.strptime(last_h, '%Y-%m-%d %H:%M:%S')
        if now < last_dt + timedelta(hours=1):
            rem = (last_dt + timedelta(hours=1)) - now
            bot.reply_to(message, f"⏳ Жди еще {int(rem.total_seconds() // 60)} мин.")
            return
    reward = random.randint(15, 60)
    update_apples(uid, reward)
    conn = sqlite3.connect("apples.db", check_same_thread=False)
    cur = conn.cursor()
    cur.execute("UPDATE users SET last_harvest = ? WHERE user_id = ?", (now.strftime('%Y-%m-%d %H:%M:%S'), uid))
    conn.commit()
    conn.close()
    bot.reply_to(message, f"🌳 Ты потряс дерево: +{reward} яблок! 🍎")

@bot.message_handler(commands=['give'])
def give(message):
    if not message.reply_to_message:
        bot.reply_to(message, "Ответь этой командой на сообщение друга!")
        return
    args = message.text.split()
    if len(args) < 2 or not args[1].isdigit():
        bot.reply_to(message, "Используй: /give [сумма]")
        return
    amount = int(args[1])
    sender_id = message.from_user.id
    receiver_id = message.reply_to_message.from_user.id
    if get_user(sender_id)[0] < amount:
        bot.reply_to(message, "❌ Мало яблок!")
        return
    update_apples(sender_id, -amount)
    update_apples(receiver_id, amount)
    bot.reply_to(message, f"🤝 Передал {amount} яблок 🍎")

init_db()
print("--- БОТ ЗАПУЩЕН ---")
bot.infinity_polling()

